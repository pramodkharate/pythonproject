# import tkinter for creating GUI apps
from hashlib import new
from os import name
import tkinter as tk 
from tkinter import filedialog, messagebox

# main window code
root = tk.Tk()
root .title("simple text editor ")
root.geometry("600x400")

# create text area
text= tk.Text (
    root,
    wrap= tk.WORD,
    font= ("helvetica",12)
)
text.pack(expand=True, fill=tk.BOTH)
text.pack(expand=True, fill=tk.BOTH)
# Main logic starts now     
 
#function 1- to create a new file 
def new_file():
    text.delete(1.0,tk.END) 

#function 2- to open an existing file
def open_file():
    #open file dialog
    file_path = filedialog.askopenfilename(
        defaultextension=".txt",
        filetypes=[("text files", "*.txt")]
    )

    if file_path:
        #open selected file
        with open(file_path, "r") as file:
            text.delete(1.0, tk.END)
            text.insert(tk.END, file.read())

#function 3- to save the file 

def save_file():
    #open save file dialog     
    file_path = filedialog.asksaveasfilename(
        defaultextension=".txt",
        filetypes=[("text files", "*.txt")]
    )
    
    if file_path:
        with open(file_path, "w") as file:
            file.write(text.get(1.0, tk.END))
            messagebox.showinfo("File Saved", "File saved successfully!")


#menu

menu = tk.Menu(root)
root.config(menu=menu)
file_menu = tk.Menu(menu)

# New ,open file ,save ,Exit 
menu .add_cascade(label="file",menu=file_menu)

file_menu.add_command(label="new", command=new_file)
file_menu.add_command(label="open", command=open_file)
file_menu.add_command(label="save", command=save_file)
file_menu.add_separator()
file_menu.add_command(label="exit", command=root.quit)









#starts and keeps the window open    
root.mainloop()
